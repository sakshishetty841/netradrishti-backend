# =======================================================
# NETRADRISHTI BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize values for local development
# =======================================================

# Environment Mode (development | staging | production)
ENVIRONMENT=development

# Security / Authentication
# Replace with a strong secret key in production (min 32 chars)
SECRET_KEY=netradrishti_super_secret_jwt_key_rural_health_2026_sih
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection URL
# SQLite default for local development: sqlite:///./netradrishti.db
# PostgreSQL example: postgresql://user:password@localhost:5432/netradrishti
DATABASE_URL=sqlite:///./netradrishti.db

# File Storage Configuration
# local (default) or s3
STORAGE_TYPE=local
MEDIA_DIR=./media

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# AI Model Configuration
MODEL_NAME=NetraDrishti-DR-Inference
MODEL_VERSION=prototype-v1
EXPLAINABILITY_VERSION=gradcam-v1

# Security / OTP Settings
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5
